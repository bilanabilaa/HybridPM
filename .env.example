# Supabase Transaction Pooler URL (Port 6543 - digunakan untuk aplikasi runtime / Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Supabase Direct Connection / Session Pooler URL (Port 5432 - digunakan Prisma untuk migrasi / CLI)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret key untuk JWT Session (32+ karakter acak)
JWT_SECRET="your-random-jwt-secret-key-min-32-chars"

# Nama Aplikasi
NEXT_PUBLIC_APP_NAME="HybridPM"
