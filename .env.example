# Database connection URL
# Gunakan PostgreSQL (Supabase / Neon / Vercel Postgres) untuk deployment online Vercel
# Gunakan "file:./dev.db" untuk development lokal SQLite
DATABASE_URL="postgresql://user:password@host:5432/hybridpm?sslmode=require"

# Secret key untuk JWT Session (generate string acak 32+ karakter)
JWT_SECRET="your-random-jwt-secret-key-min-32-chars"

# Nama Aplikasi
NEXT_PUBLIC_APP_NAME="HybridPM"
