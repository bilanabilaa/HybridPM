{
  "name": "hybridpm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.sqlite.prisma && next dev -p 3000",
    "build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:local:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "prisma:local:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "supabase:sync": "node prisma/supabase-sync.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}

